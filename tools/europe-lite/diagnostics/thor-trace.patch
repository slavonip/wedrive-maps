+// ===================== TW: трассировка (scratch, не production) =====================
+static std::unordered_set<uint64_t> g_watch;
+static bool g_watch_loaded = false;
+static double g_box[4] = {0, 0, -1, -1};
+static inline bool tw_inbox(const PointLL& p) {
+  return p.lat() >= g_box[0] && p.lng() >= g_box[1] && p.lat() <= g_box[2] && p.lng() <= g_box[3];
+}
+static void tw_load() {
+  if (g_watch_loaded) return;
+  g_watch_loaded = true;
+  if (const char* b = std::getenv("VH_WATCH_BOX"))
+    sscanf(b, "%lf,%lf,%lf,%lf", &g_box[0], &g_box[1], &g_box[2], &g_box[3]);
+  const char* v = std::getenv("VH_WATCH");
+  if (!v) return;
+  std::stringstream ss(v);
+  std::string item;
+  while (std::getline(ss, item, ',')) {
+    unsigned l = 0, t = 0, i = 0;
+    if (sscanf(item.c_str(), "%u/%u/%u", &l, &t, &i) == 3) g_watch.insert(GraphId(t, l, i).value);
+  }
+}
+static inline bool tw(const GraphId& g) {
+  return !g_watch.empty() && g.is_valid() && g_watch.count(g.value);
+}
+static std::string tg(const GraphId& g) {
+  if (!g.is_valid()) return "-";
+  return std::to_string(g.level()) + "/" + std::to_string(g.tileid()) + "/" + std::to_string(g.id());
+}
+#define TW(cond, msg)                                                                            \
+  do {                                                                                           \
+    if (cond) {                                                                                  \
+      std::ostringstream _o;                                                                     \
+      _o << "TW| " << msg;                                                                       \
+      std::cerr << _o.str() << std::endl;                                                        \
+    }                                                                                            \
+  } while (0)
+// ====================================================================================
