# Built artifacts never live in git: they are hundreds of megabytes, they are regenerated every
# month, and anything committed here is dragged down by every clone forever. They ship as release
# assets instead (see README).
*.tar
*.tar.part*
*.pmtiles
*.osm.pbf
/out/
/src/
__pycache__/

# Scratch from interrogating CI logs — never part of the factory
.*.log
.rung*.json
.paidrun
