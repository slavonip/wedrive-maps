##[group]Run mkdir -p measurements
mkdir -p measurements
cp /data/out/build-metrics.json "measurements/rung-$RUNG.json" 2>/dev/null \
  || echo "no metrics file — this build did not reach the end"
cp /data/samples.csv "measurements/rung-$RUNG-samples.csv" 2>/dev/null || true
cp /data/stages.csv "measurements/rung-$RUNG-stages.csv" 2>/dev/null || true
# NOT `|| true`. A rung without peaks has measured nothing — the first probe ran to
# completion, reported its timings, and silently carried `samples: 0` because the
# sampler could not start. Timings alone cannot say which limit binds first, which is
# the entire question, so a rung that loses them must fail loudly.
python3 scripts/peak-from-samples.py "measurements/rung-$RUNG-samples.csv" \
  --label "rung $RUNG ($SOURCE_GB GB)"

# And the verdict the build itself reached, which is the authority. The check above
# reads one file; this reads what the summariser concluded across all of them, so a
# rung cannot pass by having samples that happen to exist while a timing is missing.
python3 - <<'VERDICT'
import json, pathlib, sys, os
path = pathlib.Path(f"measurements/rung-{os.environ['RUNG']}.json")
if not path.exists():
    sys.exit("TELEMETRY INVALID: the build produced no metrics at all")
report = json.loads(path.read_text(encoding="utf-8"))
if report.get("telemetry") != "VALID":
    sys.exit(f"TELEMETRY INVALID: missing {report.get('telemetryMissing')}")
peak = report["peak"]
print(f"rung {os.environ['RUNG']}: telemetry VALID — "
      f"{peak['memoryGb']} GB peak memory (from {peak['memorySource']}), "
      f"+{peak['diskPeakDeltaGb']} GB disk of our own "
      f"({peak['diskPeakAbsoluteGb']} GB absolute)")
VERDICT
shell: bash --noprofile --norc -e -o pipefail {0}
