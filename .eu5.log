mkdir -p /data/vendor
base="https://github.com/slavonip/wedrive-maps/releases/download/maps-vendor"
asset=timezones.sqlite
version=timezones.version
if [ "vendored" != "vendored" ]; then
  asset="timezones-vendored.sqlite"
  version="timezones-vendored.version"
  echo "::notice::building against CANDIDATE timezone dataset vendored"
fi
if curl -fsSL -o /data/vendor/timezones.sqlite "$base/$asset" &&
   curl -fsSL -o /data/vendor/timezones.version "$base/$version"; then
  echo "timezones $(cat /data/vendor/timezones.version)"
else
  rm -f /data/vendor/timezones.sqlite
  echo "::warning::no timezone database ($asset); this region cannot be promoted"
fi
shell: bash --noprofile --norc -e -o pipefail {0}
##[endgroup]
timezones 2026d
##[group]Run if [ ! -f /data/vendor/timezones.sqlite ]; then
if [ ! -f /data/vendor/timezones.sqlite ]; then
  echo "no timezone database to check; the build will run without one and cannot be promoted"
  exit 0
fi
claimed="$(cat /data/vendor/timezones.version 2>/dev/null || echo unknown)"
python3 scripts/check-timezones.py /data/vendor/timezones.sqlite --expect-dataset "$claimed"
shell: bash --noprofile --norc -e -o pipefail {0}
